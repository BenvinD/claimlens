# Copy to .env and fill in the key for whichever provider you have configured as
# `active_model` in configs/default.yaml. Never commit .env.

# --- Vendor keys ------------------------------------------------------------
# Read by name: `models.<name>.api_key_env` in configs/default.yaml decides
# which variable is used. They are handed to the gateway at startup and are
# never written to disk.

# Anthropic (default: claude-haiku / claude-sonnet)
ANTHROPIC_API_KEY=

# Optional alternatives, used only if you switch `active_model`.
# OPENAI_API_KEY=

# --- Gateway (vortex-ai-gateway) --------------------------------------------
# ClaimLens runs the gateway in-process over ASGI, so these configure the
# gateway's own behaviour. Anything not set here falls back to its default.

# The client token minted by `vortex-keys create`, NOT a vendor key. It is what
# the rate limiter and the usage ledger attach to. Required once
# VORTEX_KEY_DB_PATH is set; without a key store any well-formed token is
# accepted, but a missing one is still a 401.
VORTEX_CLIENT_API_KEY=

# Hashed, revocable client keys. Mint with:
#   uv run vortex-keys create --name claimlens-batch --rpm 240 --tpm 400000
VORTEX_KEY_DB_PATH=.vortex/keys.sqlite3

# Rate limiter + usage ledger. Both need Redis and share one connection.
VORTEX_METERING_ENABLED=true
VORTEX_REDIS_URL=redis://localhost:6379/0
VORTEX_RATE_LIMIT_DEFAULT_RPM=0
VORTEX_RATE_LIMIT_DEFAULT_TPM=0

# Exact request->response cache in Redis. ClaimLens's own DiskCache sits in
# front of it and answers first, so this only catches repeats DiskCache missed.
VORTEX_CACHE_ENABLED=true
VORTEX_CACHE_TTL_SECONDS=3600
VORTEX_CACHE_SCOPE=key

# One JSON log line per request on stdout.
VORTEX_LOG_LEVEL=INFO
VORTEX_ENVIRONMENT=prod
