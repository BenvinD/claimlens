# Copy to .env and fill in the key for whichever provider you have configured as
# `active_model` in configs/default.yaml. Never commit .env.

# Anthropic (default: claude-haiku / claude-sonnet)
ANTHROPIC_API_KEY=

# Optional alternatives, used only if you switch `active_model`.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
