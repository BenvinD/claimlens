# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets - never commit real keys; see .env.example
.env
.env.*
!.env.example

# Model-response cache (content-hashed; safe to delete, expensive to rebuild)
.cache/

# Personal Claude Code overrides; .claude/settings.json IS shared and committed.
.claude/settings.local.json

# Editors / OS
.idea/
.DS_Store

# Gateway client-key store (hashed keys, but machine-local).
.vortex/
