{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "claimlens: run (test -> output.csv)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["run", "--set", "test"]
        },
        {
            "name": "claimlens: preprocess (sample)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["preprocess", "--set", "sample"]
        },
        {
            "name": "claimlens: dryrun (no API)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["dryrun", "--set", "sample"]
        },
        {
            "name": "claimlens: smoke (live, n=2)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["smoke", "--set", "sample", "--n", "2"]
        },
        {
            "name": "claimlens: validate (cached, no spend)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["validate"]
        },
        {
            "name": "claimlens: verify (predictions schema)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["verify"]
        },
        {
            "name": "claimlens: evaluate (compare models)",
            "type": "debugpy",
            "request": "launch",
            "module": "claimlens.cli",
            "console": "integratedTerminal",
            "args": ["evaluate", "--models", "claude-sonnet", "claude-haiku"]
        }
    ]
}
