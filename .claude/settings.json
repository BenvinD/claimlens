{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run claimlens preprocess:*)",
      "Bash(uv run claimlens dryrun:*)",
      "Bash(uv run claimlens validate:*)",
      "Bash(uv run claimlens verify:*)",
      "Bash(uv sync:*)",
      "Bash(make help:*)",
      "Bash(make check:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make format:*)",
      "Bash(make fmt:*)",
      "Bash(make dryrun:*)",
      "Bash(make verify:*)",
      "Bash(make validate:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vortex/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-spend.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-python.py",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
